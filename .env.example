# Node 24+. Never use a VITE_ prefix for these secrets.
# Never put real secrets in this file or in git.

# ---- Web service (apps/command) ----
PORT=3000
# Loopback is the safe default. Set HOST=0.0.0.0 only on platforms that route traffic to the app (e.g. Render health checks).
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Production: APP_ORIGIN=https://command.chaoticmindsgaming.com and NODE_ENV=production
# Canonical Chaotic Command Discord application ID, confirmed by owner.
DISCORD_CLIENT_ID=1565775506765390034
DISCORD_CLIENT_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# SQLite contains encrypted sessions and server notes. Keep private and back up.
DATA_DIR=.data

# ---- Bot worker (apps/discord-bot) ----
# Bot user token from the Discord Developer Portal. NEVER commit.
DISCORD_BOT_TOKEN=
# Application ID (same value as DISCORD_CLIENT_ID; validated against the token at startup).
DISCORD_APPLICATION_ID=1565775506765390034
# Dev guild for slash-command registration.
DISCORD_GUILD_ID=
# Optional: HTTP health endpoint port (e.g. 3001) for Docker/uptime healthchecks. 0 = disabled.
BOT_HEALTH_PORT=0
# Bind address for the health endpoint. Loopback by default.
BOT_HEALTH_HOST=127.0.0.1

# ---- Shared (web + bot) ----
# Not used yet: the app stores data in SQLite (DATA_DIR). Reserved for a future PostgreSQL migration.
# DATABASE_URL=
# development | production
NODE_ENV=development
# text | json (structured logging for the bot worker)
LOG_FORMAT=text
